<style>
:root{color-scheme:light;--bg:#F5F8FB;--surface:#fff;--ink:#1D2842;--muted:#4A5675;--line:#D5DDEA;--gold:#E3A008;--teal:#1F8A82;--lilac:#7A64D6;--coral:#E0645A;
--head:"Bricolage Grotesque","Atkinson Hyperlegible",system-ui,sans-serif;--body:"Atkinson Hyperlegible",system-ui,-apple-system,"Segoe UI",sans-serif;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--bg:#111A2E;--surface:#192541;--ink:#EEF2FA;--muted:#B3BEDA;--line:#2C3B60;--gold:#F2B632;--teal:#4CC2B8;--lilac:#A796F0;--coral:#F08C83}}
:root[data-theme="dark"]{color-scheme:dark;--bg:#111A2E;--surface:#192541;--ink:#EEF2FA;--muted:#B3BEDA;--line:#2C3B60;--gold:#F2B632;--teal:#4CC2B8;--lilac:#A796F0;--coral:#F08C83}
*,*::before,*::after{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
html[data-big="on"]{font-size:118%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.125rem/1.7 var(--body)}
h1,h2,h3{font-family:var(--head);line-height:1.1;margin:0}
a{color:inherit}
:focus-visible{outline:3px solid var(--lilac);outline-offset:3px;border-radius:4px}
.wrap{max-width:1040px;margin:0 auto;padding:0 1.25rem}
section{padding:4rem 0}
p{max-width:62ch;margin:0 0 1rem}
.skip{position:absolute;left:-999px}.skip:focus{left:1rem;top:1rem;background:var(--ink);color:var(--bg);padding:.5rem 1rem;z-index:5}
.top{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1rem 0 .5rem;flex-wrap:wrap}
.brand{font:800 1.15rem var(--head);text-decoration:none}
.tools{display:flex;gap:.5rem}
.tool{font:700 .95rem var(--body);background:var(--surface);color:var(--ink);border:2px solid var(--line);border-radius:999px;padding:.45rem 1rem;cursor:pointer}
.tool[aria-pressed="true"]{border-color:var(--teal);background:var(--teal);color:#fff}
.nav{display:flex;flex-wrap:wrap;gap:.1rem 1.2rem;padding:.25rem 0 1rem;border-bottom:1px solid var(--line);font-size:1rem}
.nav a{text-decoration:none;font-weight:700;padding:.3rem 0}.nav a:hover{text-decoration:underline}
.hero{padding:2.5rem 0 3rem;display:grid;gap:2rem;grid-template-columns:1.1fr .9fr;align-items:center}
.hero h1{font-size:clamp(2.4rem,6vw,4.4rem);font-weight:800;letter-spacing:-.02em;margin-bottom:1.25rem}
.hero p{font-size:1.25rem;color:var(--muted)}
.btns{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.25rem}
.btn{display:inline-block;text-decoration:none;font:700 1rem var(--body);padding:.8rem 1.3rem;border-radius:10px;border:2px solid var(--ink);background:transparent;color:var(--ink);cursor:pointer}
.btn.main{background:var(--ink);color:var(--bg)}
.inf{width:100%;height:auto}
.inf path{fill:none;stroke:url(#g);stroke-width:26;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:0;animation:draw 3.2s ease-out both}
@keyframes draw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}
[data-calm="on"] .inf path{animation:none;filter:saturate(.45)}
@media (prefers-reduced-motion:reduce){.inf path{animation:none}html{scroll-behavior:auto}}
h2{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:800;margin-bottom:1.1rem;max-width:22ch}
h3{font-size:1.25rem;font-weight:800;margin-bottom:.35rem}
.lead{font-size:1.2rem;color:var(--muted)}
.split{display:grid;gap:3rem;grid-template-columns:1fr 1fr}
.cols{display:grid;gap:1.5rem;grid-template-columns:repeat(3,1fr);margin-top:1.5rem}
.cols>div{border-top:5px solid var(--c,var(--teal));padding-top:.9rem}
.cols p{color:var(--muted);margin:0}
dl{margin:0}dl div{padding:1rem 0 1rem 1.1rem;border-left:5px solid var(--c,var(--teal))}dl div+div{margin-top:.5rem}
dt{font:800 1.2rem var(--head)}dd{margin:.2rem 0 0;color:var(--muted)}
.band{background:var(--surface);border-block:1px solid var(--line)}
ul.plain{margin:0 0 1rem;padding-left:1.2rem}ul.plain li{margin:.35rem 0;color:var(--muted)}ul.plain li::marker{color:var(--lilac)}
.steps{list-style:none;counter-reset:s;padding:0;margin:1.5rem 0 0;display:grid;gap:1.25rem;grid-template-columns:repeat(4,1fr)}
.steps li{counter-increment:s;border-top:5px solid var(--teal);padding-top:.7rem}
.steps li::before{content:counter(s);font:800 2rem var(--head);color:var(--teal);display:block}
.steps span{color:var(--muted);display:block}
details{border-bottom:1px solid var(--line);padding:1rem 0}
summary{cursor:pointer;font:700 1.15rem var(--body);list-style:none;display:flex;gap:.75rem;align-items:flex-start}
summary::-webkit-details-marker{display:none}
summary::before{content:"+";font:800 1.4rem/1 var(--head);color:var(--lilac);width:1.2rem;flex:none}
details[open] summary::before{content:"–"}
details p{margin:.75rem 0 0 2rem;color:var(--muted)}
.quiz{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:1.5rem;max-width:640px}
.quiz .q{font:800 1.3rem/1.3 var(--head);margin-bottom:.5rem;max-width:none}
.quiz .fb{min-height:3.4rem;color:var(--muted)}
.meta{color:var(--muted);font-size:.95rem;margin-bottom:.5rem}
.day{border-radius:18px;padding:2rem;background:linear-gradient(120deg,var(--gold),var(--coral),var(--lilac));color:#1D2842}
[data-calm="on"] .day{background:var(--surface);color:var(--ink);border:1px solid var(--line)}
.day h2{max-width:none}.day p{max-width:56ch}
.events{list-style:none;padding:0;margin:0}
.events li{display:grid;grid-template-columns:9rem 1fr;gap:1rem;padding:.9rem 0;border-bottom:1px solid var(--line)}
.events b{font-family:var(--head)}.events span{color:var(--muted)}
.note{border:2px dashed var(--line);border-radius:12px;padding:1.1rem 1.4rem;color:var(--muted)}
.note p:last-child{margin:0}
form{display:grid;gap:1rem;max-width:560px}
label{font-weight:700;display:grid;gap:.3rem}
input,textarea{font:inherit;color:var(--ink);background:var(--surface);border:2px solid var(--line);border-radius:10px;padding:.7rem .9rem;width:100%}
textarea{min-height:130px;resize:vertical}
footer{padding:2.5rem 0 3rem;color:var(--muted);font-size:1rem;border-top:1px solid var(--line)}
@media (max-width:760px){.hero,.split,.cols,.steps{grid-template-columns:1fr}section{padding:2.75rem 0}.hero{padding-bottom:1.5rem}.events li{grid-template-columns:1fr;gap:.1rem}}
